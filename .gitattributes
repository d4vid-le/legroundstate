* text=auto

# KiCad files are S-expressions; preserve their bytes (checksums, reproducibility)
*.kicad_pcb -text
*.kicad_sch -text
*.kicad_sym -text
*.kicad_mod -text
*.kicad_pro -text
*.kicad_dru -text
*.kicad_prl -text
*.net -text

# Vendored board snapshot: preserve bytes exactly (checksums / reproducibility)
boards/qt-py-esp32-s2/** -text

# Binary evidence
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gbr binary
*.drl binary

# Generated / vendored
*.safetensors binary
*.npz binary
*.npy binary
